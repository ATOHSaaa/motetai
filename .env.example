# ビルド時に読み込まれます（.env.production にコピーして値を設定）
# ローカル確認: cp .env.example .env.production

# Google Analytics 4（測定ID）
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity（プロジェクトID）
PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Google Search Console（HTMLタグ方式の確認コード）
PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 記事自動生成（任意・Anthropic API を直接使う場合のみ）
# 通常は Cursor Automation で記事執筆するため不要
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
