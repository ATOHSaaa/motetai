---
interface Props {
  variant?: 'app' | 'cosme' | 'general';
}

const { variant = 'general' } = Astro.props;

const content = {
  app: {
    title: 'マッチングアプリで出会いを増やす',
    description: 'プロフィール改善と併せて、複数アプリの併用がマッチ率向上の鉄則です。',
    cta: 'おすすめアプリを見る',
    href: '/category/matching-app',
  },
  cosme: {
    title: '清潔感は「スキンケア」から始まる',
    description: '洗顔・保湿・日焼け止めの3ステップで、第一印象は変わります。',
    cta: 'メンズスキンケア記事を読む',
    href: '/category/appearance',
  },
  general: {
    title: '恋愛は「準備」で8割決まる',
    description: '感覚ではなく、データと実践に基づいた攻略法を無料で学べます。',
    cta: '人気記事ランキングを見る',
    href: '/ranking',
  },
}[variant];
---

<aside class="my-8 rounded-xl bg-gradient-to-r from-brand-600 to-brand-800 p-6 text-white">
  <p class="text-lg font-bold">{content.title}</p>
  <p class="mt-2 text-sm leading-relaxed text-brand-100">{content.description}</p>
  <a
    href={content.href}
    class="mt-4 inline-flex items-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition hover:bg-brand-50"
  >
    {content.cta} →
  </a>
</aside>
