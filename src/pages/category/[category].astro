---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { categories, getCategory } from '../../utils/category';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
  }));
}

const { category: categorySlug } = Astro.params;
const category = getCategory(categorySlug!);

if (!category) {
  return Astro.redirect('/404');
}

const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === categorySlug)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title={category.name}
  description={category.description}
  path={`/category/${category.slug}`}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumb
      items={[{ label: 'ホーム', href: '/' }, { label: category.name }]}
    />
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">{category.name}</h1>
      <p class="mt-2 max-w-2xl text-slate-600">{category.description}</p>
      <p class="mt-2 text-sm text-slate-400">{articles.length}件の記事</p>
    </div>

    {
      articles.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.id}
              category={article.data.category}
              publishedAt={article.data.publishedAt}
              readingTime={article.data.readingTime}
            />
          ))}
        </div>
      ) : (
        <p class="text-slate-500">記事を準備中です。</p>
      )
    }
  </div>
</BaseLayout>
