---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
}

const { title, description, path, type, publishedAt, updatedAt, noindex } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <SeoHead
      title={title}
      description={description}
      path={path}
      type={type}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      noindex={noindex}
    />
    <Analytics />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
